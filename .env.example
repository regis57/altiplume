# Copiez ce fichier en .env et remplissez-le. .env n'est JAMAIS commité.
# Sur le NAS, ce fichier vit à côté du docker-compose.yml, hors du dépôt.

NODE_ENV=development
PORT=3000

# URL publique du jeu, utilisée pour les liens magiques et le domaine des passkeys.
PUBLIC_ORIGIN=http://localhost:3000

# Chemin du fichier SQLite.
DATABASE_PATH=./data/altiplume.db

# Clé d'API de l'envoi d'emails (Brevo). Laisser vide en développement :
# les liens magiques sont alors écrits dans la console au lieu d'être envoyés.
MAIL_API_KEY=
MAIL_FROM=courrier@altiplume.com

# Secret de session, 32 octets en hexadécimal.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
