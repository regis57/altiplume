# Copiez ce fichier en .env et remplissez-le. .env n'est JAMAIS commité.
# Sur le NAS, ce fichier vit à côté du docker-compose.yml, hors du dépôt.

NODE_ENV=development
PORT=3000

# URL publique du jeu, utilisée pour les liens magiques et le domaine des passkeys.
PUBLIC_ORIGIN=http://localhost:3000

# Chemin du fichier SQLite.
DATABASE_PATH=./data/altiplume.db

# Clé d'API de l'envoi d'emails (Brevo). Vide en développement : les liens
# magiques s'affichent dans la console. OBLIGATOIRE en production — sans elle,
# personne ne peut s'inscrire, et le serveur refuse de démarrer.
MAIL_API_KEY=
MAIL_FROM=courrier@altiplume.com
# Destinataire du formulaire de contact. Vide = le formulaire se déclare indisponible.
MAIL_CONTACT=bonjour@altiplume.com

# Jeton du tunnel Cloudflare (Zero Trust → Networks → Tunnels). Secret.
TUNNEL_TOKEN=

# Derrière le tunnel Cloudflare, les en-têtes X-Forwarded-* sont fiables (1).
# Automatique en production ; utile pour tester la limitation de débit en local.
TRUST_PROXY=0

# Notifications « ton courrier est arrivé » (facultatif). Générer une fois avec
# `npm run vapid` et coller les deux lignes. Sans elles, pas de notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
