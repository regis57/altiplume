{
  "name": "altiplume",
  "version": "0.3.0",
  "private": true,
  "description": "Altiplume — cozy 1930s airmail aerodrome game.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node --watch --no-warnings=ExperimentalWarning packages/server/src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "audit": "npm audit --audit-level=high --omit=dev",
    "licenses": "node scripts/check-licenses.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run audit && npm run licenses",
    "build": "npm run build -w @altiplume/client",
    "start": "node --no-warnings=ExperimentalWarning packages/server/src/server.ts",
    "e2e": "node scripts/e2e-passkeys.mjs && node scripts/e2e-courrier.mjs && node scripts/e2e-saline.mjs && node scripts/e2e-convoi.mjs && node scripts/e2e-tiers.mjs && node scripts/e2e-mise-en-page.mjs && node scripts/e2e-accessibilite.mjs",
    "vapid": "node --no-warnings=ExperimentalWarning scripts/vapid-keys.mjs",
    "simulation": "node --no-warnings=ExperimentalWarning scripts/simulation.mjs",
    "partage": "npm run build && node scripts/partage-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "axe-core": "4.14.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
